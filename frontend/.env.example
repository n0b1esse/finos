# Absolute URL of the backend API, including the /api prefix.
# Leave empty for same-origin "/api" (Docker Compose nginx / Vite dev proxy).
# For a hosted frontend (e.g. Vercel) set this to the hosted backend URL —
# in the Vercel dashboard as an Environment Variable, so it isn't committed:
#   VITE_API_BASE_URL=https://finos-api.onrender.com/api
VITE_API_BASE_URL=
